# --- Recommender weights (hybrid) ---
W_CONTENT=0.5
W_COLLAB=0.3
W_POPULARITY=0.2
MMR_LAMBDA=0.7

# --- App ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO